            {
                "type": "about-story",
                "slug": "our-story",
                "data": {
                    "view": "pub_theme::components.blocks.about.story",
                    "title": "Our idea",
                    "content": "Laravel Pizza Meetups started from a simple idea: you learn better by talking with other people who use the same tools.\n\nEvery meetup has one or more technical talks, room for questions and time to get to know each other. You sign up for free on the website, get an email confirmation and can free your seat whenever you need to.\n\nWhether you are just starting with Laravel or have used it for years, you are welcome."
                }
