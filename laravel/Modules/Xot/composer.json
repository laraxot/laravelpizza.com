{
    "name": "laraxot/module_xot_fila5",
    "description": "xot module, heart of the laraxot repository",
    "keywords": [
        "laraxot",
        "laravel",
        "nwidart",
        "modules",
        "module_xot",
        "filament"
    ],
    "homepage": "https://github.com/laraxot/module_xot_fila5",
    "license": "MIT",
    "authors": [
        {
            "name": "marco sottana",
            "email": "marco.sottana@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "awobaz/compoships": "^3.0",
        "calebporzio/sushi": "^2.5",
        "coolsam/panel-modules": "*",
        "doctrine/dbal": "*",
        "filament/filament": "^5.11",
        "filament/spatie-laravel-media-library-plugin": "*",
        "guzzlehttp/guzzle": "*",
        "laravel/folio": "^1.1",
        "laravel/framework": "^13.0",
        "laravel/pennant": "*",
        "laravel/pulse": "^1.2",
        "laravel/tinker": "*",
        "livewire/flux": "^2.1.1",
        "livewire/livewire": "*",
        "livewire/volt": "^1.0",
        "maatwebsite/excel": "^3.1",
        "nwidart/laravel-modules": "^13.0",
        "predis/predis": "*",
        "spatie/cpu-load-health-check": "^1.0",
        "spatie/laravel-data": "*",
        "spatie/laravel-health": "^1.29",
        "spatie/laravel-model-states": "*",
        "spatie/laravel-model-status": "*",
        "spatie/laravel-package-tools": "*",
        "spatie/laravel-permission": "*",
        "spatie/laravel-queueable-action": "*",
        "spatie/laravel-responsecache": "*",
        "spatie/laravel-schemaless-attributes": "*",
        "spatie/laravel-sluggable": "*",
        "spatie/laravel-tags": "*",
        "spipu/html2pdf": "^5.2",
        "staudenmeir/eloquent-has-many-deep": "*",
        "staudenmeir/laravel-adjacency-list": "*",
        "symfony/dom-crawler": "*",
        "thecodingmachine/safe": "*",
        "tightenco/parental": "*"
    },
    "require_comment": {
       
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.2",
        "fakerphp/faker": "^1.24",
        "fruitcake/laravel-debugbar": "^4.2",
        "larastan/larastan": "*",
        "laravel/boost": "^2.10",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/phpinsights": "*",
        "orchestra/testbench": "*",
        "pestphp/pest": "*",
        "pestphp/pest-plugin": "*",
        "pestphp/pest-plugin-arch": "*",
        "pestphp/pest-plugin-faker": "*",
        "pestphp/pest-plugin-laravel": "*",
        "pestphp/pest-plugin-livewire": "*",
        "pestphp/pest-plugin-mutate": "*",
        "pestphp/pest-plugin-phpstan": "*",
        "pestphp/pest-plugin-profanity": "*",
        "pestphp/pest-plugin-rector": "*",
        "pestphp/pest-plugin-type-coverage": "*",
        "phpstan/extension-installer": "*",
        "phpstan/phpdoc-parser": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-deprecation-rules": "*",
        "thecodingmachine/phpstan-safe-rule": "*"
    },
    "repositories_comment": "Local path packages (coolsam/panel-modules) moved to root composer.json for proper priority. DO NOT add Packagist here - it must remain non-canonical in root.",
    "repositories": [
        {
            "type": "path",
            "url": "../Tenant"
        },
        {
            "type": "path",
            "url": "./packages/coolsam/panel-modules"
        },
        {
            "type": "composer",
            "url": "https://packagist.org",
            "canonical": false
        }
    ],
    "autoload": {
        "psr-4": {
            "Modules\\Xot\\": "app/",
            "Modules\\Xot\\Database\\Factories\\": "database/factories/",
            "Modules\\Xot\\Database\\Seeders\\": "database/seeders/",
            "Modules\\Xot\\Tests\\": "tests/",
            "Coolsam\\FilamentModules\\": "packages/coolsam/panel-modules/src/"
        },
        "files": [
            "helpers/Helper.php"
        ]
    },
    "autoload-dev": {},
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Xot\\Providers\\XotServiceProvider",
                "Modules\\Xot\\Providers\\Filament\\AdminPanelProvider"
            ],
            "aliases": {}
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev_comment": {
        "spatie/laravel-error-solutions": "*"
    }
}
