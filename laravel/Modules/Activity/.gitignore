# .gitignore del modulo Activity (Laraxot).
# Igiene della root di modulo: docs/wiki/rules/module-theme-root-cleanup.md
# Cartelle scaffold dei tool AI: docs/no-ai-tool-scaffold-dirs.md (in questo modulo)
#
# Un solo pattern per percorso: la forma senza `/` finale vale per file e cartelle.
# Un pattern senza `/` iniziale vale a QUALUNQUE profondita' (non solo alla root del modulo):
# prima di aggiungerne uno controllare che non ignori sorgenti o docs
# (vedi bashscripts/ai/wiki/memories/gitignore-phpstan-star-swallows-bmad-story-docs.md).

# --- Dipendenze e artefatti di build ---
/vendor
/node_modules
/docs/vendor/
package-lock.json
build/
dist/
cache/

# --- File temporanei, cache, lock (anche i lock multi-agente `<file>.lock`) ---
*.cache
*.lock
*.phar
*.jar
*.tmp
*.swp
*.swo
*.stackdump
*:Zone.Identifier
v8-compile-cache-*

# --- Log ---
*.log
error_log
npm-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Laravel ---
bootstrap/compiled.php
app/storage/
public/storage
public/hot
public_html/storage
public_html/hot
storage/*.key
.env
.env.*
!.env.example

# --- Ambiente e IDE ---
Homestead.yaml
Homestead.json
/.vagrant
/.idea
.phpintel
.phpstorm.meta.php
.vscode
.cursor
.windsurf
.cursor~*
.windsurf~*
.devcontainer
.circleci
.kilocode
.kiro
.ralph

# --- Sistema operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# --- Backup e residui di merge/rebase (mai committare, es. `x~HEAD`, `x.orig`) ---
*.old
*.old1
*.old2
*.backup
*.backup.*
*.backup-*
*.backup_*
*.bak
*.bakcup
*.new
*.orig
*.rej
*~HEAD
*~head
*~BASE
*~LOCAL
*~REMOTE

# --- Git ---
.git-rewrite
.git-blame-ignore-revs

# --- Docs: archivi, cache e output di tool (la conoscenza vive in docs/) ---
_docs
_bmad-output
docs/archive
docs/archived
docs/legacy
docs/phpstan/
docs/workbench
docs/graphify

# --- Lingue: le traduzioni vivono in lang/<locale>/ ---
lang/lang/
resources/lang

# --- Cartelle legacy ---
resources/views/Components_old/
database/Migrations_old/
database/Seeders_old/
database/Factories_old/
database_old/

# --- Scaffold e tool AI/CI: non devono esistere nell'albero del modulo ---
.agents
.claude*
.codex*
.opencode
.gitmodules
.claude-audit
tests/.claude-audit
graphify-out/
agentdb.rvf
audit-coverage/
tests/AuditCoverage
bashscripts
scripts
tools
workbench
test-results
/.github/skills/

# --- Config di qualita' vietate nella root di modulo (usare laravel/phpinsights.php e laravel/rector.php) ---
phpinsights.php
rector.php

# --- Specifici del modulo Activity ---
config/local.php
config/development.php
storage/activity/
storage/logs/
activity_test_data.json
test_activity_logs.sql
activity_coverage.xml
tests/coverage
tests/coverage.xml
*.fila2

# --- Residui del progetto: clone annidati e cartelle del monorepo ---
# `Activity/` e' una cartella tracciata nella root del modulo (residuo di clone):
# non ricrearla, da pulire in una story dedicata.
Activity
laravel
public_html
