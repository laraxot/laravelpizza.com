# Text and source files
* text=auto
*.css linguist-vendored
*.scss linguist-vendored
*.js linguist-vendored

# Binary files are regular Git blobs; Git LFS is forbidden.
*.png binary !filter
*.jpg binary !filter
*.jpeg binary !filter
*.gif binary !filter
*.webp binary !filter
*.ico binary !filter
*.svg binary !filter
*.psd binary !filter
*.pdf binary !filter
*.zip binary !filter
*.woff binary !filter
*.woff2 binary !filter
*.ttf binary !filter
*.eot binary !filter
*.otf binary !filter
*.phar binary !filter
*.db binary !filter
*.sqlite binary !filter

# Export ignore files
CHANGELOG.md export-ignore
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/phpunit.xml.dist export-ignore
/art export-ignore
/docs export-ignore
/tests export-ignore
/.editorconfig export-ignore
/.php_cs.dist.php export-ignore
/psalm.xml export-ignore
/psalm.xml.dist export-ignore
/testbench.yaml export-ignore
/UPGRADING.md export-ignore
/phpstan.neon.dist export-ignore
/phpstan-baseline.neon export-ignore

# PHP files
*.php text diff=php

# Blade templates
*.blade.php text

# Configuration files
*.json text
*.yaml text
*.yml text
*.xml text
*.ini text
*.env text
*.env.* text

# Shell scripts
*.sh text eol=lf

# Documentation
*.md text
*.txt text
*.rst text

# Git files
*.gitignore text
*.gitattributes text

# Composer
composer.json text
composer.lock text

# Package files
package.json text
package-lock.json text
yarn.lock text

# Build files
webpack.mix.js text
vite.config.js text
tailwind.config.js text
postcss.config.js text

# IDE files
*.vscode/* text
*.idea/* text
