#!/bin/bash
# Wiki Search CLI - QMD-powered search for PTVX documentation
# Usage: wiki-search [OPTIONS] "search query"
#
# Examples:
#   wiki-search "context-mode"
#   wiki-search --module gdpr "consent workflow"
#   wiki-search --semantic "user permissions"
#   wiki-search --type concept "design patterns"

set -euo pipefail

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
WIKI_ROOT="$PROJECT_ROOT/docs/wiki"
MODULES_ROOT="$PROJECT_ROOT/laravel/Modules"
THEMES_ROOT="$PROJECT_ROOT/laravel/Themes"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Default options
QUERY=""
COLLECTION="wiki"
SEMANTIC=false
DOC_TYPE=""
LIMIT=10
FORMAT="table"
SHOW_HELP=false
SHOW_RELATIONS=false
RELATIONS_FILE=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            SHOW_HELP=true
            shift
            ;;
        -c|--collection)
            COLLECTION="$2"
            shift 2
            ;;
        -m|--module)
            COLLECTION="module_${2^}"
            shift 2
            ;;
        -t|--theme)
            COLLECTION="theme_${2^}"
            shift 2
            ;;
        --semantic)
            SEMANTIC=true
            shift
            ;;
        --type)
            DOC_TYPE="$2"
            shift 2
            ;;
        -l|--limit)
            LIMIT="$2"
            shift 2
            ;;
        --format)
            FORMAT="$2"
            shift 2
            ;;
        --related)
            SHOW_RELATIONS=true
            RELATIONS_FILE="$2"
            shift 2
            ;;
        -*)
            echo -e "${RED}Error: Unknown option $1${NC}" >&2
            SHOW_HELP=true
            shift
            ;;
        *)
            QUERY="$1"
            shift
            ;;
    esac
done

# Show help if requested or no query provided (and not --related)
if [[ "$SHOW_HELP" == true ]] || { [[ -z "$QUERY" ]] && [[ "$SHOW_RELATIONS" == false ]]; }; then
    cat << 'EOF'
Wiki Search CLI - Search PTVX documentation

USAGE:
  wiki-search [OPTIONS] "search query"
  wiki-search --related <file>

OPTIONS:
  -h, --help              Show this help message
  -c, --collection NAME   Search specific collection (default: wiki)
  -m, --module NAME       Search module-specific docs (e.g., --module gdpr)
  -t, --theme NAME        Search theme-specific docs
  --semantic              Use semantic similarity search (slower but contextual)
  --type TYPE             Filter by document type (concept, guide, reference, example)
  -l, --limit N           Limit results to N items (default: 10)
  --format FORMAT         Output format: table, json, csv (default: table)
  --related FILE          Show related pages and cross-references for FILE

EXAMPLES:
  # Search root wiki
  wiki-search "context-mode"

  # Search module documentation
  wiki-search --module gdpr "consent workflow"

  # Semantic search (requires QMD vectors)
  wiki-search --semantic "user permissions and access control"

  # Filter by document type
  wiki-search --type concept "design patterns"

  # Show related pages for a document
  wiki-search --related docs/wiki/concepts/actions-over-services.md

  # Get more results
  wiki-search --limit 20 "testing strategies"

COLLECTIONS:
  wiki              Root project wiki (docs/wiki/)
  modules-docs      All module documentation
  module_MODULE     Specific module (e.g., module_Gdpr)

PERFORMANCE:
  Keyword search typically completes in < 500ms
  Semantic search typically completes in < 2000ms
EOF
    exit 0
fi

# Function to perform search
perform_search() {
    local query="$1"
    local collection="$2"
    local use_semantic="$3"

    # Build QMD command
    local qmd_cmd="qmd search"

    if [[ "$use_semantic" == true ]]; then
        qmd_cmd="$qmd_cmd --semantic"
    fi

    qmd_cmd="$qmd_cmd -c $collection \"$query\""

    # Execute search and capture output
    eval "$qmd_cmd" 2>/dev/null || echo ""
}

# Function to show related pages and cross-references
show_related_pages() {
    local file="$1"
    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    # Check if file exists
    if [[ ! -f "$file" ]]; then
        echo -e "${RED}Error: File not found: $file${NC}" >&2
        return 1
    fi

    # Use wiki-relations helper to show backlinks and related content
    "$script_dir/wiki-relations" --file "$file" --backlinks --format "$FORMAT"
}

# Function to format results as table
format_table() {
    local json_output="$1"

    if [[ -z "$json_output" ]]; then
        echo -e "${YELLOW}No results found${NC}"
        return 1
    fi

    echo -e "${GREEN}Search Results:${NC}\n"
    echo -e "${BLUE}Title${NC}\t${BLUE}Path${NC}\t${BLUE}Type${NC}"
    echo "---"

    # Parse and display results (format depends on QMD output)
    echo "$json_output"
}

# Function to format results as JSON
format_json() {
    local search_results="$1"
    echo "$search_results" | jq '.'
}

# Function to format results as CSV
format_csv() {
    local search_results="$1"
    echo "Title,Path,Type,Updated"
    echo "$search_results" | while read -r line; do
        echo "\"$line\""
    done
}

# Handle --related mode
if [[ "$SHOW_RELATIONS" == true ]]; then
    echo -e "${BLUE}Analyzing relations for: $(basename "$RELATIONS_FILE")${NC}"
    START_TIME=$(date +%s%N)

    show_related_pages "$RELATIONS_FILE"

    END_TIME=$(date +%s%N)
    ELAPSED_MS=$(( (END_TIME - START_TIME) / 1000000 ))

    echo ""
    echo -e "${BLUE}Time:${NC} ${ELAPSED_MS}ms"
    exit $?
fi

# Perform search with timing
echo -e "${BLUE}Searching ${COLLECTION}...${NC}"
START_TIME=$(date +%s%N)

RESULTS=$(perform_search "$QUERY" "$COLLECTION" "$SEMANTIC")

END_TIME=$(date +%s%N)
ELAPSED_MS=$(( (END_TIME - START_TIME) / 1000000 ))

# Display results
echo ""
if [[ -z "$RESULTS" ]]; then
    echo -e "${YELLOW}No results found in ${COLLECTION}${NC}"
    echo -e "Query: ${BLUE}$QUERY${NC}"
    echo -e "Time: ${ELAPSED_MS}ms"
    exit 0
fi

# Format and display based on selected format
case "$FORMAT" in
    table)
        format_table "$RESULTS"
        ;;
    json)
        format_json "$RESULTS"
        ;;
    csv)
        format_csv "$RESULTS"
        ;;
    *)
        echo "$RESULTS"
        ;;
esac

# Show performance metrics
echo ""
echo -e "${BLUE}Performance:${NC} ${ELAPSED_MS}ms"
if [[ $ELAPSED_MS -lt 2000 ]]; then
    echo -e "${GREEN}✓ Within performance target (< 2000ms)${NC}"
else
    echo -e "${YELLOW}⚠ Exceeded performance target (${ELAPSED_MS}ms > 2000ms)${NC}"
fi
