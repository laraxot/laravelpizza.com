#!/bin/bash

# pre-commit hook to prevent use of RefreshDatabase in tests
# Install by running:
# cp .git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

# Colors for better readability
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

echo -e "${BLUE}${BOLD}LARAXOT PTVX PRE-COMMIT VALIDATION${NC}"

# Get the list of PHP files that are staged for commit
STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep "\.php$")

if [ -z "$STAGED_PHP_FILES" ]; then
    echo -e "${GREEN}No PHP files staged for commit.${NC}"
    exit 0
fi

# Temporary file to store staged files
TEMP_DIR=$(mktemp -d)
trap 'rm -rf "$TEMP_DIR"' EXIT

# Check for RefreshDatabase in staged files
VIOLATIONS_FOUND=0

for file in $STAGED_PHP_FILES; do
    # Only check PHP files in modules (for tests)
    if [[ $file == *"laravel/Modules"* && $file == *"Test.php"* ]]; then
        # Get staged version of file
        git show ":$file" > "$TEMP_DIR/$(basename "$file")"
        
        # Check for RefreshDatabase patterns
        if grep -q "RefreshDatabase" "$TEMP_DIR/$(basename "$file")" || \
           grep -q "refreshDatabase" "$TEMP_DIR/$(basename "$file")"; then
            
            VIOLATIONS_FOUND=1
            echo -e "\n${RED}${BOLD}ERROR:${NC} Prohibited ${RED}RefreshDatabase${NC} usage detected in: ${YELLOW}$file${NC}"
            
            # Show the lines with the violation
            echo -e "${YELLOW}Violation details:${NC}"
            grep -n --color=always -A 1 -B 1 -E "RefreshDatabase|refreshDatabase" "$TEMP_DIR/$(basename "$file")"
        fi
    fi
done

if [ $VIOLATIONS_FOUND -eq 1 ]; then
    echo -e "\n${RED}${BOLD}❌ COMMIT REJECTED: RefreshDatabase is strictly prohibited in Laraxot PTVX tests${NC}"
    echo -e "${RED}Please remove all instances of RefreshDatabase and use approved alternatives:${NC}"
    echo -e "  - Use ${GREEN}DatabaseTransactions${NC} trait instead"
    echo -e "  - Use in-memory SQLite database for unit tests"
    echo -e "  - Create isolated test data with factories and states"
    echo -e "  - See documentation: ${BLUE}/laravel/Modules/Xot/docs/testing/database_testing_rules.md${NC}"
    exit 1
fi

# Run the full validation script on all tests to catch any issues outside staged files
echo -e "\n${YELLOW}Running full test validation...${NC}"
BASHSCRIPT_PATH="/var/www/html/ptvx/bashscripts/test_checks/check_refresh_database.sh"

if [ -f "$BASHSCRIPT_PATH" ]; then
    # Run with relative path since absolute path might be different in other environments
    bash ./bashscripts/test_checks/check_refresh_database.sh ./laravel
    VALIDATION_RESULT=$?
    
    if [ $VALIDATION_RESULT -ne 0 ]; then
        echo -e "\n${RED}${BOLD}❌ COMMIT REJECTED: RefreshDatabase detected in tests${NC}"
        exit 1
    fi
else
    echo -e "${YELLOW}Warning: Full validation script not found at $BASHSCRIPT_PATH${NC}"
    echo -e "${YELLOW}Skipping full validation. Please run validation script manually.${NC}"
fi

echo -e "\n${GREEN}${BOLD}✓ Pre-commit validation passed${NC}"
exit 0