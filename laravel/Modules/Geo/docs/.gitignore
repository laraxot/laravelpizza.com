# ======================================================
vendor/
composer.lock
*.phar
.phpunit.result.cache
.php-cs-fixer.cache
.php_cs.cache
.phpintel

# ======================================================
# NODE / FRONTEND
# ======================================================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
npm-debug.log

# ======================================================
# BUILD / DIST / OUTPUT
# ======================================================
build/
dist/
out/
coverage/
cache/
tmp/
tmp*/

# ======================================================
# LARAVEL
# ======================================================
laravel/vendor/
laravel/bootstrap/cache/*
laravel/storage/
laravel/storage/*
laravel/build/
laravel/composer
laravel/vite-module-loader.js
laravel/stubs/

laravel/_ide_helper.php
laravel/_ide_helper_models.php

laravel/resources/lang/vendor/
laravel/resources/views/vendor/
laravel/app/View/Components/vendor/

# Moduli / cache specifiche
laravel/bootstrap/cache/modules.php
laravel/Modules/<nome progetto>/
laravel/Modules/User/lang/lang/

# Config DB locali (auto-generati)
laravel/config/**/database/content/information_schema_tables.json

# Themes / extras
laravel/Themes/*/extras/

