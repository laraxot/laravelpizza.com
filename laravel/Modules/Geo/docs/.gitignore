*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*.old
*.old1
*.old2
*_old
*.rej
~$*
~*.*
*.cache
*.log
*.log.*
error_log

# ======================================================
# AMBIENTI E CONFIGURAZIONI LOCALI
# ======================================================
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

