{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "larastan/larastan": "*",
        "laravel/framework": "^13.0",
        "nwidart/laravel-modules": "^13.0",
        "predis/predis": "*",
        "sentry/sentry-laravel": "*",
        "thecodingmachine/phpstan-safe-rule": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }, 
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --ansi"
        ],
        "go": [
            "rm -rf resources/views/vendor",
            "rm -rf bootstrap/cache/filament",
            "/usr/bin/php artisan vendor:publish --all",
            "rm -rf ./app/View/Components/vendor",
            "/usr/bin/php artisan filament:upgrade",
            "/usr/bin/php artisan filament:optimize",
            "/usr/bin/php artisan optimize",
            "/usr/bin/php artisan route:clear",
            "/usr/bin/php artisan livewire:publish --assets",
            "/usr/bin/php artisan ide-helper:generate",
            "/usr/bin/php artisan ide-helper:models --no-interaction",
            "/usr/bin/php artisan serve"
        ],
        "fix-storage": [
            "bash tools/fix-storage-permissions.sh"
        ],
        "clear": [
            "bash tools/fix-storage-permissions.sh",
            "rm -rf resources/views/vendor",
            "rm -rf bootstrap/cache/filament",
            "@php artisan vendor:publish --all",
            "rm -rf ./app/View/Components/vendor",
            "@php artisan livewire:publish --assets",
            "@php artisan filament:upgrade",
            "@php artisan filament:optimize",
            "@php artisan optimize",
            "@php artisan route:clear"
        ],
        "optimize": [
            "@php artisan filament:upgrade",
            "@php artisan filament:optimize",
            "@php artisan optimize"
        ],
        "chmod": [
            "sudo chmod 777 -R ."
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "carthage-software/mago": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
