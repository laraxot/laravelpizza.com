includes:
    - phpstan-baseline.neon
    - ./vendor/larastan/larastan/extension.neon

parameters:
    level: 1
    paths:
        - .

    excludePaths:
        - ./vendor/*
        - ./docs/*
        - ./Tests/*

    checkMissingIterableValueType: false

    ignoreErrors:
        - '#Trait Modules\\Rating\\Models\\Traits\\HasRating is used zero times#'

