{
    "name": "nwidart/pdnd",
    "description": "PDND (Piattaforma Digitale Nazionale Dati) integration module for the Laraxot ecosystem: API interoperability, e-services, and digital public administration.",
    "keywords": [
        "laraxot",
        "laravel",
        "filament",
        "module_pdnd",
        "pdnd",
        "interoperability",
        "digital-administration",
        "api-gateway",
        "e-services"
    ],
    "authors": [
        {
            "name": "Nicola Storgato",
            "email": "storgatonicola@provincia.treviso.it"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Pdnd\\Providers\\PdndServiceProvider",
                "Modules\\Pdnd\\Providers\\Filament\\AdminPanelProvider"
            ],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\Pdnd\\": "app/",
            "Modules\\Pdnd\\Database\\Factories\\": "database/factories/",
            "Modules\\Pdnd\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Modules\\Pdnd\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3"
    }
}
