{
    "name": "laraxot/module_indennitaresponsabilita_fila5",
    "description": "Responsibility allowances module for the Laraxot ecosystem: position-based bonuses, role compensation, and management allowances.",
    "keywords": [
        "laraxot",
        "laravel",
        "filament",
        "module_indennitaresponsabilita",
        "allowances",
        "responsibility-bonus",
        "role-compensation",
        "rating",
        "hr"
    ],
    "license": "MIT",
    "homepage": "https://github.com/laraxot/module_indennitaresponsabilita_fila5.git",
    "authors": [
        {
            "name": "Marco Sottana",
            "email": "marco.sottana@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {},
    "repositories": [
        {
            "type": "path",
            "url": "../Xot"
        },
        {
            "type": "path",
            "url": "../Tenant"
        },
        {
            "type": "path",
            "url": "../UI"
        }
    ],
    "autoload": {
        "psr-4": {
            "Modules\\IndennitaResponsabilita\\": "app/",
            "Modules\\IndennitaResponsabilita\\Database\\Factories\\": "database/factories/",
            "Modules\\IndennitaResponsabilita\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [],
        "post-update-cmd": [],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "./vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\IndennitaResponsabilita\\Providers\\IndennitaResponsabilitaServiceProvider",
                "Modules\\IndennitaResponsabilita\\Providers\\Filament\\AdminPanelProvider"
            ],
            "aliases": {}
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Modules\\IndennitaResponsabilita\\Tests\\": "tests/"
        }
    }
}
