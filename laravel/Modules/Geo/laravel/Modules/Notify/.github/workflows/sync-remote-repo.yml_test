name: Sync Remote Repo

on:
  push:
    branches:
      - dev
  workflow_dispatch:

permissions:
  contents: write

jobs:
  sync:
    if: github.ref == 'refs/heads/dev' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    env:
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: 'true'
      CI: true
      SKIP_SUBTREE_BACKUP: '1'

    steps:
      - name: Checkout main repository
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
          token: ${{ secrets.BASHSCRIPTS_TOKEN || github.token }}
          submodules: false

      - name: Configure Git authentication
        run: |
          TOKEN="${{ secrets.BASHSCRIPTS_TOKEN }}"
          if [ -z "$TOKEN" ]; then
            TOKEN="${{ github.token }}"
          fi
          git config --global user.name "GitHub Action"
          git config --global user.email "action@github.com"
          git config --global core.symlinks false
          git config --global --add safe.directory "$GITHUB_WORKSPACE"
          git config --global --add safe.directory "$GITHUB_WORKSPACE/bashscripts"
          git config --global url."https://x-access-token:${TOKEN}@github.com/".insteadOf "git@github.com:"
          git config --global url."https://x-access-token:${TOKEN}@github.com/".insteadOf "ssh://git@github.com/"
          git config --global url."https://x-access-token:${TOKEN}@github.com/".insteadOf "https://github.com/"

      - name: Checkout bashscripts repository
        uses: actions/checkout@v5
        with:
          repository: laraxot/bashscripts_fila5
          ref: dev
          token: ${{ secrets.BASHSCRIPTS_TOKEN || github.token }}
          path: bashscripts
          fetch-depth: 0
          sparse-checkout: |
            git/
            lib/
            gitmodules.ini
          sparse-checkout-cone-mode: false

      - name: Verify sync prerequisites
        shell: bash
        run: |
          bash --version
          test -f bashscripts/gitmodules.ini || { echo "gitmodules.ini not found"; exit 1; }
          test -f bashscripts/git/subtrees/sync_remote_repo.sh || { echo "sync_remote_repo.sh not found"; exit 1; }
          bash -n bashscripts/git/subtrees/sync_remote_repo.sh
          sh_err_file="$GITHUB_WORKSPACE/.sync-sh-test.err"
          if sh bashscripts/git/subtrees/sync_remote_repo.sh > "$sh_err_file" 2>&1; then
            echo "sync_remote_repo.sh unexpectedly succeeded under sh"
            rm -f "$sh_err_file"
            exit 1
          fi
          grep -q "requires bash" "$sh_err_file"
          rm -f "$sh_err_file"

      - name: Run remote sync
        shell: bash
        run: |
          chmod +x bashscripts/git/subtrees/sync_remote_repo.sh
          bash bashscripts/git/subtrees/sync_remote_repo.sh laraxot
        env:
          BASHSCRIPTS_TOKEN: ${{ secrets.BASHSCRIPTS_TOKEN }}
          GITHUB_TOKEN: ${{ github.token }}
          CI: true
          SKIP_SUBTREE_BACKUP: "1"

      - name: Configure Git for committing
        run: |
          git config --global user.name "GitHub Action"
          git config --global user.email "action@github.com"

      - name: Commit and push synced changes
        run: |
          echo "🔍 Checking for changes..."
          git status --short
          
          if [ -z "$(git status --porcelain)" ]; then
            echo "✅ No changes - all subtrees already in sync"
            exit 0
          fi
          
          echo "📝 Changes detected, committing..."
          git add -A .
          git commit -m "chore: sync remote subtrees [skip ci]"
          
          echo "🔄 Pulling latest changes..."
          git pull --rebase origin dev || true
          
          echo "⬆️ Pushing changes..."
          git push origin HEAD:dev || {
            echo "❌ Push failed, pulling again and retrying..."
            git pull --rebase origin dev
            git push origin HEAD:dev
          }
          
          echo "✅ Sync complete and changes pushed!"
