name: Sync Subtrees

on:
  push:
    branches:
      - dev
  workflow_dispatch:

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: 'true'
  GIT_AUTHOR_NAME: GitHub Actions
  GIT_AUTHOR_EMAIL: actions@github.com
  GIT_COMMITTER_NAME: GitHub Actions
  GIT_COMMITTER_EMAIL: actions@github.com

permissions:
  contents: write

jobs:
  sync-subtrees:
    name: Sync Git Subtrees
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/dev' || github.event_name == 'workflow_dispatch'

    steps:
      - name: Checkout repository
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
          token: ${{ secrets.BASHSCRIPTS_TOKEN || github.token }}
          submodules: false

      - name: Configure Git
        run: |
          TOKEN="${{ secrets.BASHSCRIPTS_TOKEN }}"
          if [ -z "$TOKEN" ]; then
            TOKEN="${{ github.token }}"
          fi
          git config --global user.name "GitHub Actions"
          git config --global user.email "actions@github.com"
          git config --global core.symlinks false
          git config --global --add safe.directory "$GITHUB_WORKSPACE"
          git config --global --add safe.directory "$GITHUB_WORKSPACE/bashscripts"
          git config --global url."https://x-access-token:${TOKEN}@github.com/".insteadOf "git@github.com:"
          git config --global url."https://x-access-token:${TOKEN}@github.com/".insteadOf "ssh://git@github.com/"
          git config --global url."https://x-access-token:${TOKEN}@github.com/".insteadOf "https://github.com/"

      - name: Checkout bashscripts repository
        uses: actions/checkout@v5
        with:
          repository: laraxot/bashscripts_fila5
          ref: dev
          token: ${{ secrets.BASHSCRIPTS_TOKEN || github.token }}
          path: bashscripts
          fetch-depth: 0

      - name: Show gitmodules.ini
        shell: bash
        run: |
          echo "Configuration:"
          cat bashscripts/gitmodules.ini | head -20 || cat gitmodules.ini | head -20 || echo "gitmodules.ini not found"

      - name: Verify sync script shell contract
        shell: bash
        run: |
          bash --version
          test -f bashscripts/git/subtrees/sync_remote_repo.sh
          bash -n bashscripts/git/subtrees/sync_remote_repo.sh
          if sh bashscripts/git/subtrees/sync_remote_repo.sh >/tmp/sync-subtrees-sh.err 2>&1; then
            echo "sync_remote_repo.sh unexpectedly succeeded under sh"
            exit 1
          fi
          grep -q "requires bash" /tmp/sync-subtrees-sh.err

      - name: Sync Subtrees
        shell: bash
        run: |
          echo "Starting subtree sync..."
          echo "Working directory: $(pwd)"
          echo "Current branch: $(git branch --show-current)"
          echo ""
          if [ ! -f gitmodules.ini ] && [ -f bashscripts/gitmodules.ini ]; then
            cp bashscripts/gitmodules.ini gitmodules.ini
          fi
          chmod +x bashscripts/git/subtrees/sync_remote_repo.sh
          bash bashscripts/git/subtrees/sync_remote_repo.sh laraxot
        env:
          BASHSCRIPTS_TOKEN: ${{ secrets.BASHSCRIPTS_TOKEN || github.token }}
          GITHUB_TOKEN: ${{ github.token }}
          CI: "true"
          GITHUB_ACTIONS: "true"
          SKIP_SUBTREE_BACKUP: "1"

      - name: Commit synced changes
        run: |
          git status --short

          if [ -z "$(git status --porcelain)" ]; then
            echo "No changes to commit after sync"
            exit 0
          fi

          git add -A .
          # We don't reset bashscripts anymore to ensure everything is captured if needed,
          # but usually bashscripts is in .gitignore or checked out as a separate path.

          git commit -m "chore: sync subtrees [skip ci]"
          git pull --rebase origin dev
          git push origin HEAD:dev

      - name: Sync Complete
        run: |
          echo "Subtree synchronization completed!"
          echo "Branch: ${{ github.ref_name }}"
          echo "Commit: ${{ github.sha }}"
