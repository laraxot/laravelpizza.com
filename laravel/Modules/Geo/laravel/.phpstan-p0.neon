includes:
    #- ./phpstan-baseline.neon
    - ./vendor/larastan/larastan/extension.neon
    - ./vendor/nesbot/carbon/extension.neon
    - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - ./vendor/thecodingmachine/phpstan-safe-rule/phpstan-safe-rule.neon
    - ./vendor/pestphp/pest/extension.neon

parameters:
    parallel:
        maximumNumberOfProcesses: 0

    paths:
        - Modules/
        #- Themes

    level: max
    #parallel:
        # Use single process only - no parallel workers to avoid 512M memory exhaustion
        # maximumNumberOfProcesses: 0
        # Parallel processing disabled completely to avoid memory issues with child processes
        # If still getting memory errors, exclude more modules or run individually

    ignoreErrors:
        # - '#Static call to instance method Nwidart#'
        - '#is used zero times and is not analysed#'
        # - "#^Unsafe usage of new static#"
        - '#Cannot cast mixed to (string|float|double|int|bool|boolean).#' # Ignora errori di cast da mixed a tipi specifici
        - identifier: missingType.generics
        - identifier: missingType.iterableValue
        - identifier: larastan.noEnvCallsOutsideOfConfig 
        # - identifier: method.unused

    excludePaths:
        - ./*/lang/*
        - ./*/database/*
        - ./*/resources/*
        - ./*/bashscripts/*
        - ./*/scripts/*
        - ./*/routes/*
        - ./*/tools/*
        - ./*/workbench/*

        - ./*/vendor/*
        - ./*/tests/*
        - ./*/build/*
        - ./*/docs/*
        - ./*/Main_files/*
        - ./*/phpinsights.php
        - ./*/rector.php
        - ./*/*.blade.php
        #- ./config/local/*/database.php
        # MEMORY OPTIMIZATION: Most modules excluded due to WSL2/system memory constraints
        # Run analysis per-module individually: php -d memory_limit=-1 ./vendor/bin/phpstan analyse Modules/[ModuleName]
        #- ./Modules/Activity/*
        #- ./Modules/CertFisc/*
        #- ./Modules/ContoAnnuale/*
        #- ./Modules/DbForge/*
        #- ./Modules/Europa/*
        #- ./Modules/Gdpr/*
        #- ./Modules/Inail/*
        #- ./Modules/Incentivi/*
        #- ./Modules/IndennitaCondizioniLavoro/*
        #- ./Modules/IndennitaResponsabilita/*
        #- ./Modules/Job/*
        #- ./Modules/Lang/*
        #- ./Modules/Legge104/*
        #- ./Modules/Legge109/*
        #- ./Modules/Media/*
        #- ./Modules/Mensa/*
        #- ./Modules/MobilitaVolontaria/*
        #- ./Modules/Notify/*
        #- ./Modules/Pdnd/*
        #- ./Modules/Performance/*
        #- ./Modules/Prenotazioni/*
        #- ./Modules/PresenzeAssenze/*
        #- ./Modules/Progressioni/*
        #- ./Modules/Ptv/*
        #- ./Modules/Questionari/*
        #- ./Modules/Rating/*
        #- ./Modules/Setting/*
        #- ./Modules/Sigma/*
        #- ./Modules/Sindacati/*
        #- ./Modules/Tenant/*
        #- ./Modules/UI/*
        #- ./Modules/User/*
        #- ./Modules/Xot/*

    bootstrapFiles:
        - ./phpstan_constants.php
        - ./phpstan-bootstrap.php
        # Removed OAuthenticatable stub - conflicts with real Passport interface
        #- ./phpstan-stubs/OAuthenticatable.php
        #- ./vendor/amenadiel/jpgraph/src/config.inc.php

    scanFiles:
        - ./Modules/Xot/helpers/Helper.php

    mixinExcludeClasses:
        - ./Modules/Badge/Models
        - IdeHelperTimbra

    editorUrl: 'vscode://file/%%file%%:%%line%%'

    tmpDir: /tmp/phpstan/
    # Disable parallel processing to avoid memory issues

    noUnnecessaryCollectionCall: false
    checkUnusedViews: false
    checkModelProperties: false
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    checkOctaneCompatibility: false
