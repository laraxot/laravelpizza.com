includes:
    # - ./phpstan-baseline.neon  # DISABLED: Gli errori vanno corretti, non ignorati!
    - ./vendor/larastan/larastan/extension.neon  
    - ./vendor/nesbot/carbon/extension.neon
    - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - ./vendor/thecodingmachine/phpstan-safe-rule/phpstan-safe-rule.neon
    - ./vendor/pestphp/pest/extension.neon


parameters:

    paths:
        - Modules/
        #- Themes

    level: max
    parallel:
        jobSize: 50
        maximumNumberOfProcesses: 2
        minimumNumberOfJobsPerProcess: 1

    ignoreErrors:
        # - '#Static call to instance method Nwidart#'
        # - '#is used zero times and is not analysed#'
        # - "#^Unsafe usage of new static#"
        - '#Cannot cast mixed to (string|float|double|int|bool|boolean).#' # Ignora errori di cast da mixed a tipi specifici
        # - identifier: missingType.generics
        # - identifier: missingType.iterableValue
        # - identifier: larastan.noEnvCallsOutsideOfConfig 
        # - identifier: method.unused

    excludePaths:

        - ./*/bashscripts/*
        - ./*/scripts/*
        - ./*/vendor/*
        - ./*/build/*
        - ./*/docs/*

        - ./*/phpinsights.php
        - ./*/rector.php
        - ./*/*.blade.php
        - ./*/tests/*
        # MEMORY OPTIMIZATION: Most modules excluded due to WSL2/system memory constraints
        # Run analysis per-module individually: php -d memory_limit=-1 ./vendor/bin/phpstan analyse Modules/[ModuleName]
        #- ./Modules/Activity/*
        #- ./Modules/CertFisc/*
        #- ./Modules/ContoAnnuale/*
        #- ./Modules/DbForge/*
        #- ./Modules/Europa/*
        #- ./Modules/Gdpr/*
        #- ./Modules/Inail/*
        - ./Modules/Incentivi/*
        #- ./Modules/IndennitaCondizioniLavoro/*
        #- ./Modules/IndennitaResponsabilita/*
        #- ./Modules/Job/*
        #- ./Modules/Lang/*
        #- ./Modules/Legge104/*
        #- ./Modules/Legge109/*
        #- ./Modules/Media/*
        #- ./Modules/Mensa/*
        #- ./Modules/MobilitaVolontaria/*
        #- ./Modules/Notify/*
        - ./Modules/Pdnd/*
        #- ./Modules/Performance/*
        #- ./Modules/Prenotazioni/*
        #- ./Modules/PresenzeAssenze/*
        #- ./Modules/Progressioni/*
        #- ./Modules/Ptv/*
        #- ./Modules/Questionari/*
        #- ./Modules/Rating/*
        #- ./Modules/Setting/*
        #- ./Modules/Sigma/*
        #- ./Modules/Sindacati/*
        #- ./Modules/Tenant/*
        #- ./Modules/UI/*
        #- ./Modules/User/*
        #- ./Modules/Xot/*

    bootstrapFiles:
        - ./phpstan_constants.php
        - ./phpstan-bootstrap.php
        # Removed OAuthenticatable stub - conflicts with real Passport interface
        #- ./phpstan-stubs/OAuthenticatable.php
        #- ./vendor/amenadiel/jpgraph/src/config.inc.php

    scanFiles:
        - ./Modules/Xot/helpers/Helper.php

    stubFiles:
        # - ./Modules/Xot/stubs/filament-panel.stub

    mixinExcludeClasses:
        # - ./Modules/Badge/Models
        # - IdeHelperTimbra

    editorUrl: 'vscode://file/%%file%%:%%line%%'

    tmpDir: /tmp/phpstan/
    # Disable parallel processing to avoid memory issues

    noUnnecessaryCollectionCall: false
    checkUnusedViews: false
    checkModelProperties: false
    treatPhpDocTypesAsCertain: false
    # reportUnmatchedIgnoredErrors: false
    checkOctaneCompatibility: false
